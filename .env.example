## Stripe platform credentials — never expose these in the browser or commit .env
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

## Password requested before the private dashboard is shown. Set this in your
## hosting provider too (for Vercel: Project Settings → Environment Variables).
## Never expose it with a VITE_ prefix.
DASHBOARD_PASSWORD=scegli-una-password-lunga-e-unica

## Optional net fee retained by the platform, in integer cents. Keep 0 to
## transfer only Stripe's 1.5% + €0.25 processing cost to the Express account.
STRIPE_PLATFORM_MARKUP_CENTS=0

## Public HTTPS URL used by Stripe for redirects and webhooks.
## In local development use your Stripe CLI forwarding URL or a tunnel URL.
APP_URL=https://example.com

## Local SQLite database used by `npm run dev`. It is not read by Vercel.
DATABASE_PATH=./data/registry.sqlite

## Persistent SQLite-compatible database used only by Vercel Functions.
## Create it with the Turso integration in the Vercel Marketplace.
giuliaspd_TURSO_DATABASE_URL=libsql://your-database.turso.io
giuliaspd_TURSO_AUTH_TOKEN=your-turso-auth-token
